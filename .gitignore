# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Test corpus: real books used to check extraction quality. Never committed --
# they are copyrighted, and a document's text must not leave the device.
*.pdf
/fixtures/local/

# Inspection output from `npm run inspect`
/out/

# Prebuilt native library, fetched by `npm run setup:tts` rather than committed:
# 49MB in git history is permanent, and the release it comes from is immutable.
/modules/sherpa-tts/android/libs/*.aar

# Gradle build output for the local native module
/modules/*/android/build/
/modules/*/android/.cxx/
/modules/*/android/.gradle/

# Phonemiser data, fetched by `npm run setup:espeak` rather than committed
/modules/sherpa-tts/android/src/main/assets/espeak-ng-data/

# The release signing key and its password. /android above already covers
# these; they are named again because that line is the sort of thing people
# remove when they start committing the native project, and a signing key
# leaked once cannot be un-leaked -- nor replaced, without every existing
# install refusing the update.
android/papervoice-release.keystore
android/keystore.properties
# The signing key. Outside android/, which prebuild recreates.
/keys/

# Voice models downloaded to render the samples, and the catalog dump the
# generator reads. The finished samples in assets/ are committed; these are not.
scripts/.voices/
scripts/voices.json

# Design scratch: mockups, references and competitor screenshots. Working
# material, not part of the project, and not something to publish.
/design

# Local working documents, not part of the shipped project: the business
# brief (pricing, competitors, targets) and the agent implementation plans.
/PROJECT_BRIEF_V3_PAPERVOICE.md
/docs/superpowers
